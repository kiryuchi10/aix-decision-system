########################################
# 🔐 Security & Secrets (ABSOLUTE)
########################################

# Environment variables
.env
.env.*
*.env

# Secrets & credentials
**/secrets.*
**/*secret*
**/*credentials*
**/*apikey*
**/*api_key*
**/*token*
**/*password*
**/*passwd*
**/*private*
**/*oauth*
**/*gmail*
**/*mail*
**/*auth*

