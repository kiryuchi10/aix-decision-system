# AiX Decision System - Backend .gitignore
# Do not commit: .env, secrets, dumps, or dev credentials.
# Schema: backend/schema.sql and backend/scripts/setup_database.sql are tracked.

# ========== Security & secrets ==========
.env
.env.*
!.env.example
*.env
config/secrets.json
config/production.json
app/core/secrets.py
**/secrets*
**/*credentials*
**/*apikey*
**/*password*
**/*token*
secrets/
private_keys/
certificates/
ssl/
SECRETS.md
API_KEYS.md
PRODUCTION_SETUP.md
DEPLOYMENT_NOTES.md
SECURITY.md
local_settings.py
development.py

# ========== Database: dumps/backups only (schema is tracked) ==========
dump*.sql
backup*.sql
*_backup.sql
*.db
*.sqlite
*.sqlite3
database/data/
migrations/versions/*.py
!migrations/versions/__init__.py

# ========== Data & uploads ==========
data/
datasets/
uploads/
downloads/
*.csv
*.parquet
*.json.bak

# ========== Python ==========
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
env/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.python-version
Pipfile.lock
poetry.lock
*.sage.py
.ropeproject
.spyderproject
.spyproject
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
cython_debug/
/site

# ========== ML / artifacts ==========
models/
ml_models/
ml_experiments/
mlruns/
checkpoints/
experiments/
artifacts/
*.pkl
*.joblib
*.h5
*.pb
*.onnx
*.pt
*.pth

# ========== Testing ==========
.pytest_cache/
.coverage
coverage.xml
htmlcov/
test-results/
.tox/
.nox/
*.cover
.hypothesis/
.cache
nosetests.xml

# ========== Logs ==========
logs/
*.log
app.log
error.log
access.log
celery.log
celerybeat-schedule
celerybeat.pid

# ========== Notebooks ==========
.ipynb_checkpoints/
*.ipynb
profile_default/
ipython_config.py

# ========== Alembic (optional: keep versions if you use them) ==========
# alembic/versions/*.py
# !alembic/versions/__init__.py

# ========== IDE / OS ==========
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.bak
*.backup
*.old
*.tmp
*.temp
.dockerignore.bak
*.prof
*.profile
