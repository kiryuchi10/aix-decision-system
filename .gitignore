# AiX Decision System - Root .gitignore
# Do not commit: secrets, env files, dumps, or dev-only credentials.
# Docs: only README and docs/ (supplements) are tracked.

# ========== Security & secrets (never commit) ==========
.env
.env.*
!.env.example
*.env
config/secrets.json
config/production.json
**/secrets/
**/*secret*
**/*credentials*
**/*apikey*
**/*api_key*
**/*token*
**/*password*
**/*passwd*
**/*private*
**/*oauth*
ssl/
certificates/
*.pem
*.key
*.crt
private_keys/

# Sensitive docs (never commit)
SECRETS.md
API_KEYS.md
PRODUCTION_SETUP.md
DEPLOYMENT_NOTES.md
SECURITY.md
PASSWORDS.md
CONFIG_NOTES.md

# ========== Database (dumps/backups only; schema is tracked) ==========
dump*.sql
backup*.sql
*_backup.sql
*.db
*.sqlite
*.sqlite3
mysql_data/
redis_data/
influxdb_data/

# ========== Data & uploads (runtime / user data) ==========
data/
datasets/
uploads/
downloads/
*.csv
*.parquet
*.json.bak

# ========== ML / AI artifacts ==========
models/
ml_models/
ml_experiments/
mlruns/
checkpoints/
experiments/
artifacts/
*.pkl
*.joblib
*.h5
*.onnx
*.pt
*.pth

# ========== Python ==========
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
env/
ENV/
.venv/

# ========== Node / frontend ==========
node_modules/

# ========== Testing & coverage ==========
.pytest_cache/
.coverage
coverage.xml
htmlcov/
test-results/
.nyc_output/
playwright-report/

# ========== IDE / OS ==========
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ========== Docker / local overrides ==========
docker-compose.override.yml
docker-compose.local.yml
.dockerignore.bak

# ========== Markdown: only README and docs/ (supplements) ==========
*.md
!README.md
!docs/*.md
!docs/**/*.md
!CHANGELOG.md

# ========== Logs / temp / backups ==========
logs/
*.log
tmp/
temp/
.cache/
backups/
*.backup
*.bak
*.tar.gz
*.zip
*.prof
*.profile
monitoring/data/
grafana/data/
prometheus/data/
security-scan-results/
vulnerability-reports/
