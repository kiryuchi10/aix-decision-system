# AiX Decision System - Environment Configuration Example
# Copy this file to .env and update with your actual values
# NEVER commit the actual .env file to version control

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Primary Database (MySQL)
DATABASE_URL=mysql+pymysql://aix_user:your_password_here@localhost:3306/aix_decision_db

# MySQL Root Password (for Docker setup)
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=aix_decision_db
MYSQL_USER=aix_user
MYSQL_PASSWORD=your_secure_db_password_here

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here

# InfluxDB (Time Series Database)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=aix-org
INFLUXDB_BUCKET=sensor-data
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=your_influx_admin_password_here

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Application Secret Keys (CHANGE THESE!)
SECRET_KEY=your-very-secure-secret-key-change-this-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-for-token-signing-change-this-too
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Security
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=3600

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment
ENVIRONMENT=development
DEBUG=true

# ML Pipeline Configuration
MODEL_STORAGE_PATH=./models
MAX_CONCURRENT_PIPELINES=3
ML_WORKER_CONCURRENCY=4

# Process Parameters (Default Values)
TEMPERATURE_MIN=840.0
TEMPERATURE_MAX=860.0
TEMPERATURE_OPTIMAL=850.0
PRESSURE_MIN=2.3
PRESSURE_MAX=2.7
PRESSURE_OPTIMAL=2.5

# FDC Parameters
DRIFT_DETECTION_WINDOW=100
ALARM_THRESHOLD_SIGMA=2.0

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASSWORD=your-email-app-password-here
SMTP_TLS=true

# AWS Configuration (Optional - for backups/storage)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-west-2
AWS_S3_BUCKET=aix-system-backups

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Grafana
GRAFANA_PASSWORD=your-secure-grafana-password

# Prometheus
PROMETHEUS_RETENTION_TIME=15d

# Logging Level
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Backend Performance
GUNICORN_WORKERS=4
WORKER_MEMORY_LIMIT=2G
WORKER_TIMEOUT=300

# Database Performance
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=30
SQLALCHEMY_POOL_TIMEOUT=30

# Redis Performance
REDIS_MAX_MEMORY=512mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# =============================================================================
# SSL/TLS CONFIGURATION (Production)
# =============================================================================

# SSL Certificates (if using HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_ENABLED=false

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Development Database (SQLite for local dev)
# DATABASE_URL=sqlite:///./aix_system.db

# Development Redis (if not using Docker)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# Production URLs
# FRONTEND_URL=https://aix.company.com
# BACKEND_URL=https://api.aix.company.com

# Production Database with SSL
# DATABASE_URL=mysql+pymysql://user:pass@prod-db:3306/aix_db?ssl_ca=/path/to/ca.pem

# Production Security
# DEBUG=false
# ENVIRONMENT=production
# SSL_ENABLED=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key-here

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/Disable Features
ENABLE_ML_PIPELINE=true
ENABLE_REAL_TIME_MONITORING=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_AUDIT_LOGGING=true

# =============================================================================
# INTEGRATION SETTINGS
# =============================================================================

# MES System Integration (if applicable)
MES_API_URL=http://mes-system:8080/api
MES_API_KEY=your-mes-api-key-here

# ERP Integration (if applicable)
ERP_API_URL=http://erp-system:9000/api
ERP_API_KEY=your-erp-api-key-here

# =============================================================================
# NOTES
# =============================================================================

# 1. Replace all "your_*_here" values with actual credentials
# 2. Use strong passwords (minimum 12 characters)
# 3. Generate unique secret keys for each environment
# 4. Never commit this file with real values to version control
# 5. Use different credentials for development, staging, and production
# 6. Regularly rotate passwords and API keys
# 7. Consider using a secrets management system for production