# Frontend Docker ignore

# Documentation
*.md
docs/
README*

# Git
.git
.gitignore

# Environment files (except example)
.env*
!.env.example

# Dependencies (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs (will be built in container)
dist/
build/
.next/
out/

# Testing
tests/
test/
__tests__/
*.test.*
*.spec.*
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Cache
.cache/
.parcel-cache/
.vite/

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Docker files
Dockerfile*
docker-compose*
.dockerignore

# Local development
.local
local.config.*

# Bundle analyzer reports
bundle-analyzer-report.html
webpack-bundle-analyzer-report.html

# Source maps (if not needed in production)
*.map

# Storybook
.storybook-out/
storybook-static/