# AiX Decision System - Frontend .gitignore
# Do not commit: .env, secrets, local config, or dev credentials.
# Docs: only README (and docs/ if present) are tracked.

# ========== Security & secrets ==========
.env
.env.*
!.env.example
*.env
config.local.json
settings.local.json
**/secrets*
**/*credentials*
**/*apikey*
**/*password*
**/*token*
ssl/
certificates/
*.pem
*.key
*.crt
SECRETS.md
API_KEYS.md
PRODUCTION_SETUP.md
CONFIG_NOTES.md
.sentryclirc

# ========== Dependencies & build ==========
node_modules/
/.pnp
.pnp.js
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.output/
.vercel/
.netlify/
*.tgz
.yarn-integrity
.cache
.parcel-cache
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.rollup.cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.local
local.config.js
local.config.ts

# ========== Logs & runtime ==========
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock
.npm
.node_repl_history

# ========== Testing & coverage ==========
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/
cypress/downloads/

# ========== TypeScript / tooling ==========
*.tsbuildinfo
.eslintcache
.stylelintcache
bundle-analyzer-report.html
webpack-bundle-analyzer-report.html
.scannerwork/
lighthouse-reports/
performance-reports/
src/generated/
generated/
api-docs/
mock-data/
test-data/

# ========== IDE / OS ==========
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.DS_Store
Thumbs.db

# ========== Markdown: only README (and docs if any) ==========
*.md
!README.md
!docs/*.md
!docs/**/*.md

# ========== Backup / temp ==========
*.bak
*.backup
*.old
tmp/
temp/
